[Unit]
Description=pisosscraper web viewer (gunicorn)
After=network.target

[Service]
Type=simple
# EDIT: replace with the user that owns /docker/stack_pisosscraper
User=deploy
WorkingDirectory=/docker/stack_pisosscraper
Environment="PATH=/docker/stack_pisosscraper/venv/bin"
ExecStart=/docker/stack_pisosscraper/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 web:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
